# Stable Flask / admin secrets
SECRET_KEY=replace-with-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password
FLASK_DEBUG=0
PREFERRED_URL_SCHEME=https

# RAG generation. Without this key the site still answers from local KB.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Voice recognition via Groq Whisper. Without it Chrome/Edge browser STT is used.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Primary instant lead notification.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Independent backup channel through existing n8n.
N8N_LEAD_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=


# Booking (MSK)
BOOKING_FIRST_HOUR=9
BOOKING_LAST_HOUR=20
BOOKING_SLOT_MINUTES=60
BOOKING_DAYS_AHEAD=14
BOOKING_MIN_LEAD_HOURS=2
BOOKING_MAX_PER_CLIENT_PER_DAY=2

# Outbound proxy for providers blocked from the server network.
# PROXY_URL is used by OpenAI and as a fallback for Telegram/Groq.
PROXY_URL=
TELEGRAM_PROXY=
GROQ_PROXY=

# PECF11 FAQ RAG service (FastAPI + FAISS)
# Local run: http://127.0.0.1:8011
# Docker Compose: http://dkorworld2-faq-rag:8011
FAQ_RAG_URL=
FAQ_RAG_TIMEOUT=45
FAQ_CHAT_MODEL=gpt-4.1-mini
FAQ_EMBEDDING_MODEL=text-embedding-3-small
FAQ_MIN_SCORE=0.30
OPENAI_PROXY=

